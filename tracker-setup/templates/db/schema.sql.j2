-- {{ project_name }} schema. Generated by tracker-setup. See README.md.
{% if has_contact %}
CREATE TABLE {{ contact_plural }} (
    id          SERIAL PRIMARY KEY,
    name        TEXT NOT NULL,
    {{ contact_org_field }}      TEXT,
    notes       TEXT,
    UNIQUE (name, {{ contact_org_field }})
);
{% endif %}

CREATE TABLE {{ entity_plural }} (
    id                  SERIAL PRIMARY KEY,
    {{ primary_field }}             TEXT NOT NULL,
    {{ secondary_field }}             TEXT NOT NULL,
    source_type         TEXT NOT NULL CHECK (source_type IN (
                            {{ source_type_options | map('sqlstr') | join(',\n                            ') }})),
{% if has_contact %}
    {{ contact_singular }}_id        INTEGER REFERENCES {{ contact_plural }}(id),
{% endif %}
    date_first_contact  DATE,
    current_stage       TEXT NOT NULL CHECK (current_stage IN (
                            {{ stages | map('sqlstr') | join(',\n                            ') }})),
    next_step           TEXT,
    next_step_date      DATE,
{% if has_value %}
    {{ value_field_prefix }}_text       TEXT,       -- raw disclosed string, e.g. "$150K-$200K + equity"
    {{ value_field_prefix }}_min        NUMERIC,    -- parsed low end, nullable, for charting
    {{ value_field_prefix }}_max        NUMERIC,    -- parsed high end, nullable, for charting
{% endif %}
    location            TEXT,
{% if has_category %}
    {{ category_field }}            TEXT,       -- coarse category for filtering
{% endif %}
    source_link         TEXT,
    notes                TEXT,
{% if has_scout_agent %}
{% if artifact_enabled %}
    {{ artifact_field_prefix }}_needed     BOOLEAN,    -- set by the scout-agent skill for {{ queued_stage | tojson }} rows
    {{ artifact_field_prefix }}_draft      TEXT,       -- drafted by the scout-agent skill, for you to review/use
    {{ artifact_field_prefix }}_file_path  TEXT,       -- resolved absolute path to the drafted file on disk
    {{ artifact_field_prefix }}_requested  BOOLEAN NOT NULL DEFAULT false,  -- set via the dashboard's "Request {{ artifact_label }}" button
{% endif %}
    match_tier           TEXT CHECK (match_tier IN ('A','B')),  -- set by the scout-agent skill; see Match tiers in its SKILL.md
    found_via            TEXT,       -- which search term/source surfaced this (scout-agent skill)
{% endif %}
    insight_text         TEXT,       -- rough, regenerable read on how this one looks; see .claude/skills/{{ entity_singular }}-insights
    insight_generated_at TIMESTAMPTZ,
    created_at           TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at           TIMESTAMPTZ NOT NULL DEFAULT now()
);

{% if has_scout_agent %}
CREATE TABLE scout_runs (
    id                          SERIAL PRIMARY KEY,
    run_at                      TIMESTAMPTZ NOT NULL DEFAULT now(),
    terms_covered               TEXT[],
    sources_covered             TEXT[],
    candidates_reviewed         INTEGER,
    candidates_queued           INTEGER,
    candidates_from_backlog     INTEGER,
    cap_hit                     BOOLEAN NOT NULL DEFAULT false,
    candidates_overflow         INTEGER,
    notes                       TEXT
);
{% endif %}

CREATE TABLE stage_history (
    id              SERIAL PRIMARY KEY,
    {{ entity_singular }}_id  INTEGER NOT NULL REFERENCES {{ entity_plural }}(id) ON DELETE CASCADE,
    stage           TEXT NOT NULL,
    changed_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    note            TEXT
);

-- Free-form notes you add over time (interview debriefs, follow-ups). The
-- {{ entity_plural }}.notes column above is a single blurb; this is the running log.
CREATE TABLE {{ entity_singular }}_notes (
    id              SERIAL PRIMARY KEY,
    {{ entity_singular }}_id  INTEGER NOT NULL REFERENCES {{ entity_plural }}(id) ON DELETE CASCADE,
    note            TEXT NOT NULL,
    stage_at_time   TEXT,       -- the stage it was in when the note was written
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    edited_at       TIMESTAMPTZ           -- set when the note's text is changed
);
CREATE INDEX {{ entity_singular }}_notes_by_{{ entity_singular }} ON {{ entity_singular }}_notes ({{ entity_singular }}_id, created_at DESC);

CREATE OR REPLACE FUNCTION touch_updated_at() RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = now();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_touch_updated_at
BEFORE UPDATE ON {{ entity_plural }}
FOR EACH ROW EXECUTE FUNCTION touch_updated_at();

-- AFTER trigger, not BEFORE: stage_history.{{ entity_singular }}_id has a FK to
-- {{ entity_plural }}(id), so the {{ entity_singular }} row must already exist.
CREATE OR REPLACE FUNCTION log_stage_change() RETURNS TRIGGER AS $$
BEGIN
    IF TG_OP = 'INSERT' OR NEW.current_stage IS DISTINCT FROM OLD.current_stage THEN
        INSERT INTO stage_history ({{ entity_singular }}_id, stage) VALUES (NEW.id, NEW.current_stage);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_log_stage_change
AFTER INSERT OR UPDATE ON {{ entity_plural }}
FOR EACH ROW EXECUTE FUNCTION log_stage_change();
