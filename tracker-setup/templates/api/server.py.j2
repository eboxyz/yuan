@app.post("/api/{{ entity_plural }}/{item_id}/mark-committed")
def mark_committed(item_id: int):
    rows = execute(
        "UPDATE {{ entity_plural }} SET current_stage = %s, date_first_contact = COALESCE(date_first_contact, CURRENT_DATE) WHERE id = %s AND current_stage = %s RETURNING id",
        ({{ baseline_stage | tojson }}, item_id, {{ queued_stage | tojson }}),
    )
    if not rows:
        raise HTTPException(status_code=404, detail="Queued {{ entity_singular }} not found")
    return {"ok": True}


