@app.post("/api/{{ entity_plural }}/{item_id}/reveal-{{ artifact_slug }}")
def reveal_{{ artifact_field_prefix }}(item_id: int):
    rows = query("SELECT {{ artifact_field_prefix }}_file_path FROM {{ entity_plural }} WHERE id = %s", (item_id,))
    if not rows or not rows[0]["{{ artifact_field_prefix }}_file_path"]:
        raise HTTPException(status_code=404, detail="No file on disk for this {{ entity_singular }}")
    path = Path(rows[0]["{{ artifact_field_prefix }}_file_path"]).resolve()
    if {{ artifact_field_prefix | upper }}_FILES_DIR not in path.parents or not path.is_file():
        raise HTTPException(status_code=404, detail="File not found on disk")
    reveal_in_file_manager(path)
    return {"ok": True}


@app.get("/api/{{ entity_plural }}/{item_id}/download-{{ artifact_slug }}")
def download_{{ artifact_field_prefix }}(item_id: int):
    rows = query("SELECT {{ artifact_field_prefix }}_file_path FROM {{ entity_plural }} WHERE id = %s", (item_id,))
    if not rows or not rows[0]["{{ artifact_field_prefix }}_file_path"]:
        raise HTTPException(status_code=404, detail="No file on disk for this {{ entity_singular }}")
    path = Path(rows[0]["{{ artifact_field_prefix }}_file_path"]).resolve()
    if {{ artifact_field_prefix | upper }}_FILES_DIR not in path.parents or not path.is_file():
        raise HTTPException(status_code=404, detail="File not found on disk")
    return FileResponse(path, filename=path.name, headers={"X-Content-Type-Options": "nosniff"})
