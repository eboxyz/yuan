app = FastAPI(title="{{ project_name }} API")

# Local-only hardening. This app serves its own dashboard, so it configures no
# CORS at all: other websites can't read its responses from your browser. The
# host allow-list stops DNS-rebinding, and the check below stops other sites
# (or other local ports) from changing your data.
app.add_middleware(TrustedHostMiddleware, allowed_hosts=["localhost", "127.0.0.1"])


# The dashboard loads only its own files (fonts and styles are bundled), and
# pages may only talk to this server. Inline scripts and styles are allowed
# because the pages are self-contained.
CSP = ("default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; "
       "img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; "
       "base-uri 'none'; frame-ancestors 'none'")


@app.middleware("http")
async def security_headers(request: Request, call_next):
    response = await call_next(request)
    response.headers.setdefault("Content-Security-Policy", CSP)
    response.headers.setdefault("Referrer-Policy", "no-referrer")
    response.headers.setdefault("X-Content-Type-Options", "nosniff")
    return response


@app.middleware("http")
async def block_cross_site_writes(request: Request, call_next):
    if request.method not in ("GET", "HEAD", "OPTIONS"):
        origin = request.headers.get("origin")
        if origin is not None and urlparse(origin).netloc != request.headers.get("host", ""):
            return JSONResponse({"detail": "Cross-origin request blocked"}, status_code=403)
        if request.headers.get("sec-fetch-site") == "cross-site":
            return JSONResponse({"detail": "Cross-site request blocked"}, status_code=403)
    return await call_next(request)


def query(sql: str, params: tuple = ()):
    with psycopg.connect(DB_DSN, row_factory=dict_row) as conn:
        with conn.cursor() as cur:
            cur.execute(sql, params)
            return cur.fetchall()


def execute(sql: str, params: tuple = ()):
    with psycopg.connect(DB_DSN, row_factory=dict_row) as conn:
        with conn.cursor() as cur:
            cur.execute(sql, params)
            rows = cur.fetchall()
            conn.commit()
            return rows

{% if has_scout_agent and artifact_enabled %}

def reveal_in_file_manager(path: Path):
    system = platform.system()
    if system == "Darwin":
        subprocess.run(["open", "-R", str(path)], check=False)
    elif system == "Windows":
        subprocess.run(["explorer", "/select,", str(path)], check=False)
    else:
        subprocess.run(["xdg-open", str(path.parent)], check=False)
{% endif %}


@app.get("/api/{{ entity_plural }}")
def list_{{ entity_plural }}():
    return query(
        """
        SELECT e.*{% if has_contact %},
               c.name AS {{ contact_singular }}_name, c.{{ contact_org_field }} AS {{ contact_singular }}_{{ contact_org_field }}{% endif %}

        FROM {{ entity_plural }} e
        {% if has_contact %}LEFT JOIN {{ contact_plural }} c ON c.id = e.{{ contact_singular }}_id{% endif %}

        ORDER BY e.date_first_contact DESC, e.id DESC
        """
    )


STAGES = {{ stages | tojson }}


class StageBody(BaseModel):
    stage: str


class ScheduleBody(BaseModel):
    next_step: Optional[str] = Field(default=None, max_length=300)
    next_step_date: Optional[date] = None


class NoteBody(BaseModel):
    note: str = Field(min_length=1, max_length=4000)


@app.post("/api/{{ entity_plural }}/{item_id}/set-stage")
def set_stage(item_id: int, body: StageBody):
    if body.stage not in STAGES:
        raise HTTPException(status_code=400, detail=f"Unknown stage: {body.stage!r}")
    rows = execute(
        "UPDATE {{ entity_plural }} SET current_stage = %s WHERE id = %s RETURNING id, current_stage",
        (body.stage, item_id),
    )
    if not rows:
        raise HTTPException(status_code=404, detail="{{ entity_singular | capitalize }} not found")
    return rows[0]


@app.post("/api/{{ entity_plural }}/{item_id}/schedule")
def schedule_next_step(item_id: int, body: ScheduleBody):
    # Send both fields as null to clear the next step.
    rows = execute(
        "UPDATE {{ entity_plural }} SET next_step = %s, next_step_date = %s WHERE id = %s RETURNING id, next_step, next_step_date",
        ((body.next_step or "").strip() or None, body.next_step_date, item_id),
    )
    if not rows:
        raise HTTPException(status_code=404, detail="{{ entity_singular | capitalize }} not found")
    return rows[0]


@app.get("/api/{{ entity_plural }}/{item_id}/notes")
def list_notes(item_id: int):
    if not query("SELECT 1 FROM {{ entity_plural }} WHERE id = %s", (item_id,)):
        raise HTTPException(status_code=404, detail="{{ entity_singular | capitalize }} not found")
    return query(
        """
        SELECT id, note, stage_at_time, created_at, edited_at
        FROM {{ entity_singular }}_notes
        WHERE {{ entity_singular }}_id = %s
        ORDER BY created_at DESC, id DESC
        """,
        (item_id,),
    )


@app.post("/api/{{ entity_plural }}/{item_id}/notes")
def add_note(item_id: int, body: NoteBody):
    text = body.note.strip()
    if not text:
        raise HTTPException(status_code=400, detail="Note is empty")
    rows = execute(
        """
        INSERT INTO {{ entity_singular }}_notes ({{ entity_singular }}_id, note, stage_at_time)
        SELECT id, %s, current_stage FROM {{ entity_plural }} WHERE id = %s
        RETURNING id, note, stage_at_time, created_at
        """,
        (text, item_id),
    )
    if not rows:
        raise HTTPException(status_code=404, detail="{{ entity_singular | capitalize }} not found")
    return rows[0]


@app.put("/api/{{ entity_plural }}/{item_id}/notes/{note_id}")
def edit_note(item_id: int, note_id: int, body: NoteBody):
    text = body.note.strip()
    if not text:
        raise HTTPException(status_code=400, detail="Note is empty")
    rows = execute(
        """
        UPDATE {{ entity_singular }}_notes SET note = %s, edited_at = now()
        WHERE id = %s AND {{ entity_singular }}_id = %s
        RETURNING id, note, stage_at_time, created_at, edited_at
        """,
        (text, note_id, item_id),
    )
    if not rows:
        raise HTTPException(status_code=404, detail="Note not found")
    return rows[0]


@app.delete("/api/{{ entity_plural }}/{item_id}/notes/{note_id}")
def delete_note(item_id: int, note_id: int):
    rows = execute(
        "DELETE FROM {{ entity_singular }}_notes WHERE id = %s AND {{ entity_singular }}_id = %s RETURNING id",
        (note_id, item_id),
    )
    if not rows:
        raise HTTPException(status_code=404, detail="Note not found")
    return {"ok": True}


