from starlette.middleware.trustedhost import TrustedHostMiddleware

DB_DSN = "dbname={{ db_name }}"
DASHBOARD_DIR = Path(__file__).parent.parent / "dashboard"
{% if has_scout_agent and artifact_enabled %}
{{ artifact_field_prefix | upper }}_FILES_DIR = (
    Path(__file__).parent.parent / "{{ config_dir_name }}" / "{{ artifact_dir_name }}"
).resolve()
