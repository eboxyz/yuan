@app.get("/api/stats/time-in-stage")
def time_in_stage():
    # For each row, how long it's been in its current stage (from the most
    # recent stage_history entry to now).
    return query(
        """
        SELECT e.id AS {{ entity_singular }}_id, e.{{ primary_field }}, e.current_stage,
               h.changed_at AS entered_stage_at,
               EXTRACT(EPOCH FROM (now() - h.changed_at)) / 86400.0 AS days_in_stage
        FROM {{ entity_plural }} e
        JOIN LATERAL (
            SELECT changed_at FROM stage_history
            WHERE {{ entity_singular }}_id = e.id
            ORDER BY changed_at DESC
            LIMIT 1
        ) h ON true
        ORDER BY days_in_stage DESC
        """
    )


