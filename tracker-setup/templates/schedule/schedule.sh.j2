#!/usr/bin/env bash
# Turns the daily {{ entity_singular }}-scout-agent run on or off.
#   ./schedule.sh install [HH:MM]   run every day at HH:MM (default {{ daily_run if daily_run != 'off' else '08:00' }})
#   ./schedule.sh remove            stop the daily run
#   ./schedule.sh status            is it on, and when
#   ./schedule.sh permissions       what the unattended run may do without asking
# macOS uses a launchd agent in ~/Library/LaunchAgents (a run missed while the
# computer slept happens when it wakes). Linux uses one line in your crontab
# (the computer has to be on at that time).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
DIR="$(pwd)"
LABEL="com.jobsearchtracker.{{ project_slug }}.$(printf '%s' "$DIR" | cksum | cut -d' ' -f1)"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
TAG="# jst-daily-run $DIR"

when() {
  local t="${1:-{{ daily_run if daily_run != 'off' else '08:00' }}}"
  [[ "$t" =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || { echo "Use a 24-hour time like 08:00 or 18:30."; exit 1; }
  HOUR=$((10#${BASH_REMATCH[1]})); MINUTE=$((10#${BASH_REMATCH[2]})); TIME="$t"
}

remember_env() {
  # Scheduled jobs start with a bare PATH; keep the one that works right now.
  local claude_bin; claude_bin="$(command -v claude || true)"
  [ -n "$claude_bin" ] || { echo "Can't find the claude command. Install Claude Code first."; exit 1; }
  mkdir -p .claude logs
  { printf 'export PATH=%q\n' "$PATH"; printf 'export CLAUDE_BIN=%q\n' "$claude_bin"; } > .claude/daily_run.env
}

case "${1:-status}" in
  install)
    when "${2:-}"; remember_env
    if [ "$(uname)" = Darwin ]; then
      mkdir -p "$(dirname "$PLIST")"
      cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$DIR/run_daily.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>$HOUR</integer><key>Minute</key><integer>$MINUTE</integer></dict>
  <key>StandardOutPath</key><string>$DIR/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>$DIR/logs/launchd.log</string>
</dict>
</plist>
PL
      launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" "$PLIST"
    else
      command -v crontab >/dev/null || { echo "crontab isn't available on this system."; exit 1; }
      { crontab -l 2>/dev/null | grep -vF "$TAG" || true; echo "$MINUTE $HOUR * * * /bin/bash '$DIR/run_daily.sh' $TAG"; } | crontab -
    fi
    echo "The daily run is on: every day at $TIME. Log: $DIR/logs/daily_run.log" ;;
  remove)
    if [ "$(uname)" = Darwin ]; then
      launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true; rm -f "$PLIST"
    elif command -v crontab >/dev/null; then
      { crontab -l 2>/dev/null | grep -vF "$TAG" || true; } | crontab -
    fi
    echo "The daily run is off." ;;
  status)
    if [ "$(uname)" = Darwin ] && [ -f "$PLIST" ]; then
      H="$(plutil -extract StartCalendarInterval.Hour raw "$PLIST")"; M="$(plutil -extract StartCalendarInterval.Minute raw "$PLIST")"
      printf 'On: every day at %02d:%02d.\n' "$H" "$M"
    elif [ "$(uname)" != Darwin ] && crontab -l 2>/dev/null | grep -qF "$TAG"; then
      crontab -l | grep -F "$TAG" | awk '{printf "On: every day at %02d:%02d.\n", $2, $1}'
    else
      echo "Off."
    fi
    [ -f logs/daily_run.log ] && { echo "Last log lines:"; tail -n 3 logs/daily_run.log; } || true ;;
  permissions) ./run_daily.sh --print-permissions ;;
  *) sed -n 2,6p "$0"; exit 1 ;;
esac
