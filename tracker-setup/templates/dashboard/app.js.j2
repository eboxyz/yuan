// Shared helpers for all {{ app_display_name }} screens. Every screen fetches
// real data from the local API — nothing here is mocked. Generated by
// tracker-setup.

function escapeHtml(s) {
  if (s == null) return '';
  return String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

async function getJSON(path) {
  const res = await fetch(path);
  if (!res.ok) throw new Error(`${path}: ${res.status}`);
  return res.json();
}

async function sendJSON(method, path, body) {
  const res = await fetch(path, {
    method,
    headers: { 'Content-Type': 'application/json' },
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  if (!res.ok) {
    let detail = String(res.status);
    try { const j = await res.json(); if (j.detail) detail = typeof j.detail === 'string' ? j.detail : 'Invalid input'; } catch (_) {}
    throw new Error(detail);
  }
  return res.json();
}
const postJSON = (path, body) => sendJSON('POST', path, body || {});
const putJSON = (path, body) => sendJSON('PUT', path, body);
const deleteJSON = (path) => sendJSON('DELETE', path);
{% if has_value %}

function fmtMoney(n) {
  if (n == null) return null;
  return '$' + Math.round(n / 1000) + 'k';
}

function fmtValueRange(item) {
  if (item.{{ value_field_prefix }}_min != null && item.{{ value_field_prefix }}_max != null) {
    return `${fmtMoney(item.{{ value_field_prefix }}_min)} - ${fmtMoney(item.{{ value_field_prefix }}_max)}`;
  }
  if (item.{{ value_field_prefix }}_text) return item.{{ value_field_prefix }}_text;
  return 'Not disclosed';
}
{% endif %}

function relativeTime(dateStr) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  const diffMs = Date.now() - d.getTime();
  const diffDay = Math.floor(diffMs / 86400000);
  if (diffDay <= 0) return 'Today';
  if (diffDay === 1) return 'Yesterday';
  if (diffDay < 7) return `${diffDay} days ago`;
  const wk = Math.floor(diffDay / 7);
  if (wk === 1) return '1 week ago';
  if (wk < 5) return `${wk} weeks ago`;
  const mo = Math.floor(diffDay / 30);
  return mo <= 1 ? '1 month ago' : `${mo} months ago`;
}

function fmtDateLong(dateStr) {
  if (!dateStr) return '';
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
}

function fmtDateShort(dateStr) {
  if (!dateStr) return '';
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

function daysUntil(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return Math.round((d - today) / 86400000);
}

const STAGE_CHIP = {{ stage_chip_json }};

function stageChipHtml(stage, extraClasses) {
  const c = STAGE_CHIP[stage] || STAGE_CHIP[{{ baseline_stage | tojson }}];
  return `<span class="${c.bg} ${c.text} font-label-caps text-xs px-3 py-1 rounded-full inline-block text-center ${extraClasses || ''}">${c.label}</span>`;
}

// Deterministic per-{{ entity_singular }} emoji/avatar so cards have
// personality without guessing real associations we don't actually know.
const EMOJI_POOL = ['💼','🚀','🌱','⚙️','💡','🎯','🧩','🔧','📊','🛠️','🔬','💳','🏥','🧠','🌐','📦','🔋','🧭','🪄','🔭'];
const AVATAR_BG = ['bg-secondary-container','bg-tertiary-fixed','bg-primary-fixed','bg-surface-container-highest','bg-error-container','bg-tertiary-fixed-dim'];
function hashStr(s) {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return h;
}
function entityEmoji(name) { return EMOJI_POOL[hashStr(name || '') % EMOJI_POOL.length]; }
function entityAvatarBg(name) { return AVATAR_BG[hashStr('bg' + (name || '')) % AVATAR_BG.length]; }

const IN_PROGRESS_STAGES = {{ in_progress_stages | tojson }};
const CLOSED_STAGES = {{ closed_stages | tojson }};

function stats(items) {
  return {
    total: items.length,
    baseline: items.filter(i => i.current_stage === {{ baseline_stage | tojson }}).length,
    inProgress: items.filter(i => IN_PROGRESS_STAGES.includes(i.current_stage)).length,
    success: items.filter(i => i.current_stage === {{ success_stage | tojson }}).length,
    closed: items.filter(i => CLOSED_STAGES.includes(i.current_stage)).length,
  };
}
{% if has_value %}

function valueStats(items) {
  const disclosed = items.filter(i => i.{{ value_field_prefix }}_min != null && i.{{ value_field_prefix }}_max != null);
  const withValue = items.filter(i => i.{{ value_field_prefix }}_text);
  if (!disclosed.length) {
    return { count: 0, disclosedTotal: withValue.length };
  }
  const avgMin = disclosed.reduce((s, i) => s + i.{{ value_field_prefix }}_min, 0) / disclosed.length;
  const avgMax = disclosed.reduce((s, i) => s + i.{{ value_field_prefix }}_max, 0) / disclosed.length;
  const top = disclosed.reduce((best, i) => (i.{{ value_field_prefix }}_max > (best?.{{ value_field_prefix }}_max ?? -Infinity) ? i : best), null);
  return { count: disclosed.length, avgMin, avgMax, top, disclosedTotal: withValue.length };
}
{% endif %}
