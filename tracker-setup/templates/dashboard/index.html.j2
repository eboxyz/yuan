{% import "dashboard/_partials.j2" as p with context %}
<!DOCTYPE html>
<html class="h-full" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
{{ p.theme_head("Overview") }}
</head>
<body class="font-body-md text-on-background flex h-full overflow-hidden antialiased">
{{ p.sidebar_nav("overview") }}
<div class="flex-1 flex flex-col h-full overflow-hidden relative w-full">
<header class="flex justify-between items-center w-full px-4 md:px-section-margin py-unit h-20 sticky top-0 z-40 bg-background/80 backdrop-blur-md flex-shrink-0">
{{ p.mobile_brand() }}
<div class="hidden md:block">
<h2 class="font-headline-lg text-headline-lg text-on-background">Overview</h2>
</div>
{{ p.avatar_badge() }}
</header>
<main class="flex-1 overflow-y-auto px-4 md:px-section-margin pb-24 md:pb-8 w-full">
<div class="max-w-7xl mx-auto grid grid-cols-1 xl:grid-cols-3 gap-6">
<div class="xl:col-span-2 space-y-6">
<div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="statTiles"></div>
<div class="bg-white rounded-xl soft-shadow border border-surface-container overflow-hidden">
<div class="p-6 border-b border-surface-container flex justify-between items-center">
<h2 class="font-headline-md text-headline-md text-primary font-bold">Active {{ entity_plural_label }}</h2>
<span class="text-on-surface-variant text-sm" id="huntCount"></span>
</div>
<div class="overflow-x-auto overflow-y-auto max-h-[520px]">
<table class="w-full text-left border-collapse">
<thead class="sticky top-0">
<tr class="bg-surface-container-low text-on-surface-variant font-label-caps text-label-caps border-b border-surface-container">
<th class="p-4 font-bold">{{ primary_label }}</th>
<th class="p-4 font-bold">{{ secondary_label }}</th>
<th class="p-4 font-bold">Stage</th>
{% if has_value %}<th class="p-4 font-bold">{{ value_label }} Range</th>{% endif %}
<th class="p-4 font-bold">Last Updated</th>
</tr>
</thead>
<tbody class="font-body-md text-body-md divide-y divide-surface-container" id="huntBody"></tbody>
</table>
</div>
</div>
</div>
<div class="space-y-6">
{% if has_scout_agent %}
<div class="bg-white rounded-xl soft-shadow border-2 border-secondary-container p-6 hidden" id="queueTeaser">
<h3 class="font-headline-md text-headline-md text-secondary font-bold mb-4 flex items-center gap-2">
<span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">inbox</span>
Queued for Review
</h3>
<div class="space-y-3" id="queueTeaserList"></div>
</div>
{% endif %}
<div class="bg-white rounded-xl soft-shadow border border-surface-container p-6">
<h3 class="font-headline-md text-headline-md text-secondary font-bold mb-4 flex items-center gap-2">
<span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">calendar_month</span>
Upcoming
</h3>
<div class="space-y-4" id="upcomingList"></div>
</div>
{% if has_value %}
<div class="bg-white rounded-xl soft-shadow border border-surface-container p-6">
<h3 class="font-headline-md text-headline-md text-primary font-bold mb-4 flex items-center gap-2">
<span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">monitoring</span>
{{ value_label }} Snapshot
</h3>
<div class="space-y-4" id="valueSnapshot"></div>
</div>
{% endif %}
</div>
<div class="xl:col-span-3 bg-white rounded-xl soft-shadow border border-surface-container p-6">
<h3 class="font-headline-md text-headline-md text-primary font-bold mb-1 flex items-center gap-2">
<span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
Rough Insights
</h3>
<p class="text-on-surface-variant text-sm mb-4">Speculative reads, regenerated by re-running the <code>{{ entity_singular }}-insights</code> skill in this project.</p>
<div class="space-y-3" id="insightsList"></div>
</div>
</div>
</main>
</div>
{{ p.mobile_nav("overview") }}

<script src="/app.js"></script>
<script>
async function render() {
  const [items, insights{% if has_scout_agent %}, queueItems{% endif %}] = await Promise.all([
    getJSON('/api/{{ entity_plural }}'), getJSON('/api/insights'){% if has_scout_agent %}, getJSON('/api/queue'){% endif %}

  ]);
  const s = stats(items);
{% if has_scout_agent %}

  const teaser = document.getElementById('queueTeaser');
  if (queueItems.length) {
    teaser.classList.remove('hidden');
    document.getElementById('queueTeaserList').innerHTML = queueItems.slice(0, 4).map(q => `
      <a href="/queue.html" class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors border border-transparent hover:border-outline-variant">
        <div class="w-10 h-10 rounded-full ${entityAvatarBg(q.{{ primary_field }})} flex items-center justify-center shrink-0"><span class="text-lg leading-none">${entityEmoji(q.{{ primary_field }})}</span></div>
        <div class="min-w-0">
          <h4 class="font-bold text-on-surface truncate">${escapeHtml(q.{{ primary_field }})}</h4>
          <p class="text-sm text-on-surface-variant truncate">${escapeHtml(q.{{ secondary_field }})}</p>
        </div>
      </a>`).join('') + `<a href="/queue.html" class="block text-center text-sm font-bold text-primary pt-1">Review all ${queueItems.length} →</a>`;
  } else {
    teaser.classList.add('hidden');
  }
{% endif %}

  document.getElementById('statTiles').innerHTML = `
    <div class="bg-white rounded-xl p-4 soft-shadow border border-surface-container flex flex-col items-center justify-center text-center">
      <div class="w-12 h-12 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center mb-2">
        <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">send</span>
      </div>
      <span class="font-headline-md text-headline-md text-primary">${s.baseline}</span>
      <span class="font-label-caps text-label-caps text-on-surface-variant mt-1">{{ baseline_stage }}</span>
    </div>
    <div class="bg-white rounded-xl p-4 soft-shadow border border-surface-container flex flex-col items-center justify-center text-center">
      <div class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center mb-2">
        <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">record_voice_over</span>
      </div>
      <span class="font-headline-md text-headline-md text-secondary">${s.inProgress}</span>
      <span class="font-label-caps text-label-caps text-on-surface-variant mt-1">In Progress</span>
    </div>
    <div class="bg-white rounded-xl p-4 soft-shadow border border-surface-container flex flex-col items-center justify-center text-center">
      <div class="w-12 h-12 rounded-full bg-tertiary-container text-on-tertiary-container flex items-center justify-center mb-2">
        <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">celebration</span>
      </div>
      <span class="font-headline-md text-headline-md text-tertiary">${s.success}</span>
      <span class="font-label-caps text-label-caps text-on-surface-variant mt-1">{{ success_stage }}</span>
    </div>
    <div class="bg-white rounded-xl p-4 soft-shadow border border-surface-container flex flex-col items-center justify-center text-center">
      <div class="w-12 h-12 rounded-full bg-surface-container-highest text-on-surface-variant flex items-center justify-center mb-2">
        <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">cancel</span>
      </div>
      <span class="font-headline-md text-headline-md text-on-surface">${s.closed}</span>
      <span class="font-label-caps text-label-caps text-on-surface-variant mt-1">Closed</span>
    </div>
  `;

  document.getElementById('huntCount').textContent = `${items.length} tracked`;
  const sorted = [...items].sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at));
  document.getElementById('huntBody').innerHTML = sorted.map(a => `
    <tr class="hover:bg-surface-bright transition-colors">
      <td class="p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-full ${entityAvatarBg(a.{{ primary_field }})} flex items-center justify-center"><span class="text-xl leading-none">${entityEmoji(a.{{ primary_field }})}</span></div>
        <span class="font-bold text-on-surface">${escapeHtml(a.{{ primary_field }})}</span>
      </td>
      <td class="p-4 text-on-surface">${escapeHtml(a.{{ secondary_field }})}</td>
      <td class="p-4">${stageChipHtml(a.current_stage, 'min-w-[100px]')}</td>
      {% if has_value %}<td class="p-4 text-on-surface-variant text-sm">${escapeHtml(fmtValueRange(a))}</td>{% endif %}

      <td class="p-4 text-on-surface-variant text-sm">${relativeTime(a.updated_at)}</td>
    </tr>
  `).join('');

  const upcoming = items.filter(a => a.next_step_date).sort((a, b) => new Date(a.next_step_date) - new Date(b.next_step_date));
  document.getElementById('upcomingList').innerHTML = upcoming.length ? upcoming.map(a => {
    const d = new Date(a.next_step_date + 'T00:00:00');
    return `
    <div class="flex items-start gap-3 p-3 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors border border-transparent hover:border-outline-variant">
      <div class="bg-secondary-container text-on-secondary-container w-12 h-12 rounded-xl flex flex-col items-center justify-center shrink-0">
        <span class="font-label-caps text-[10px] font-bold uppercase">${d.toLocaleDateString('en-US',{month:'short'})}</span>
        <span class="font-headline-md text-lg font-black leading-none">${d.getDate()}</span>
      </div>
      <div>
        <h4 class="font-bold text-on-surface">${escapeHtml(a.next_step || 'Next step')}</h4>
        <p class="text-sm text-on-surface-variant">${escapeHtml(a.{{ primary_field }})}</p>
      </div>
    </div>`;
  }).join('') : `<p class="text-sm text-on-surface-variant">Nothing scheduled yet. Set a <code>next_step_date</code> once something's booked and it'll show up here.</p>`;
{% if has_value %}

  const vs = valueStats(items);
  let snapshotHtml = '';
  if (vs.count > 0) {
    const refMax = vs.avgMax;
    const minPct = Math.min(100, Math.round((vs.avgMin / refMax) * 100));
    const maxPct = Math.min(100, Math.round((vs.avgMax / refMax) * 100));
    snapshotHtml = `
      <div>
        <div class="flex justify-between text-sm mb-1 font-bold">
          <span class="text-on-surface">Avg disclosed low</span>
          <span class="text-primary">${fmtMoney(vs.avgMin)}</span>
        </div>
        <div class="w-full bg-surface-container-high rounded-full h-4 overflow-hidden border border-outline-variant">
          <div class="bg-primary h-4 rounded-full" style="width: ${minPct}%"></div>
        </div>
      </div>
      <div>
        <div class="flex justify-between text-sm mb-1 font-bold">
          <span class="text-on-surface">Avg disclosed high</span>
          <span class="text-secondary">${fmtMoney(vs.avgMax)}</span>
        </div>
        <div class="w-full bg-surface-container-high rounded-full h-4 overflow-hidden border border-outline-variant">
          <div class="bg-secondary h-4 rounded-full" style="width: ${maxPct}%"></div>
        </div>
      </div>
      <div class="pt-2">
        <p class="text-sm text-on-surface-variant text-center bg-surface-container-low p-2 rounded-lg italic">
          Across ${vs.count} disclosed range${vs.count === 1 ? '' : 's'}, average is ${fmtMoney(vs.avgMin)}–${fmtMoney(vs.avgMax)}. ${vs.top ? `Top so far: <strong>${escapeHtml(vs.top.{{ primary_field }})}</strong> up to ${fmtMoney(vs.top.{{ value_field_prefix }}_max)}.` : ''}
        </p>
      </div>`;
  } else {
    snapshotHtml = `<p class="text-sm text-on-surface-variant">No parsed {{ value_label | lower }} data yet.</p>`;
  }
  document.getElementById('valueSnapshot').innerHTML = snapshotHtml;
{% endif %}

  document.getElementById('insightsList').innerHTML = insights.length ? insights.map(r => `
    <div class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-3 p-3 rounded-xl bg-surface-container-low border border-transparent">
      <div class="flex items-baseline gap-2 shrink-0 md:w-56">
        <span class="font-bold text-on-surface">${escapeHtml(r.{{ primary_field }})}</span>
        ${stageChipHtml(r.current_stage, 'text-[10px]')}
      </div>
      <p class="text-sm text-on-surface-variant">${escapeHtml(r.insight_text)}</p>
    </div>
  `).join('') : `<p class="text-sm text-on-surface-variant">No insights generated yet — run the <code>{{ entity_singular }}-insights</code> skill.</p>`;
}
render();
</script>
</body></html>
