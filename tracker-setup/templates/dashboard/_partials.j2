{# Shared macros for every dashboard page. Not rendered as a standalone file
   -- generate_project.py never emits this one directly, only files that
   {% import %} it. Keeps the 5 pages visually and structurally consistent
   without hand-copying the Tailwind theme/nav into each one. #}

{% macro theme_head(page_title) -%}
<title>{{ app_display_name }} - {{ page_title }}</title>
<link rel="icon" href="favicon.svg" type="image/svg+xml"/>
<link rel="stylesheet" href="fonts.css"/>
<link rel="stylesheet" href="tailwind.css"/>
<style>
  .soft-shadow { box-shadow: 0 4px 20px -2px rgba(45, 106, 79, 0.08), 0 2px 6px -1px rgba(234, 226, 216, 0.6); }
  .squishy-btn:active { transform: translateY(2px); box-shadow: 0 4px 10px rgba(45, 106, 79, 0.06); }
</style>
{%- endmacro %}

{% macro sidebar_nav(active) -%}
<nav class="hidden md:flex bg-surface-container-low h-screen w-64 rounded-r-lg shadow-sm flex-col py-8 px-4 border-r border-outline-variant/20 z-50 flex-shrink-0">
<div class="mb-10 px-4 flex items-center gap-3">
<img src="logo.svg" alt="" class="w-10 h-10"/>
<div>
<h1 class="font-headline-md text-headline-md font-extrabold text-primary">{{ app_display_name }}</h1>
<p class="font-body-md text-body-md text-on-surface-variant text-sm">{{ tagline }}</p>
</div>
</div>
<div class="flex-1 flex flex-col gap-2">
{% for item in [
  {"href": "/", "icon": "dashboard", "label": "Overview", "key": "overview"},
  {"href": "/" ~ entity_plural ~ ".html", "icon": "work", "label": entity_plural_label, "key": "entities"},
  {"href": "/upcoming.html", "icon": "event_upcoming", "label": "Upcoming", "key": "upcoming"},
] + ([{"href": "/value.html", "icon": "payments", "label": value_label, "key": "value"}] if has_value else [])
  + ([{"href": "/queue.html", "icon": "inbox", "label": "Queue", "key": "queue", "badge": true}] if has_scout_agent else []) %}
{% if item.key == active %}
<a class="flex items-center gap-3 bg-secondary-container text-on-secondary-container font-bold rounded-full px-4 py-3" href="{{ item.href }}">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">{{ item.icon }}</span><span class="font-label-caps text-label-caps">{{ item.label }}</span>
{% if item.badge %}<span id="navQueueCount" class="ml-auto bg-tertiary-container text-on-tertiary text-[11px] font-bold rounded-full w-5 h-5 flex items-center justify-center"></span>{% endif %}
</a>
{% else %}
<a class="flex items-center gap-3 text-on-surface-variant px-4 py-3 hover:bg-surface-container-high transition-colors duration-200 rounded-full" href="{{ item.href }}">
<span class="material-symbols-outlined">{{ item.icon }}</span><span class="font-label-caps text-label-caps">{{ item.label }}</span>
{% if item.badge %}<span id="navQueueCount" class="ml-auto bg-tertiary-container text-on-tertiary text-[11px] font-bold rounded-full w-5 h-5 flex items-center justify-center"></span>{% endif %}
</a>
{% endif %}
{% endfor %}
</div>
</nav>
{%- endmacro %}

{% macro mobile_nav(active) -%}
<nav class="md:hidden fixed bottom-0 w-full bg-surface-container-low shadow-[0_-4px_20px_rgba(0,0,0,0.05)] z-50 px-4 py-2 flex justify-between items-center">
{% for item in [
  {"href": "/", "icon": "dashboard", "label": "Overview", "key": "overview"},
  {"href": "/" ~ entity_plural ~ ".html", "icon": "work", "label": "Items", "key": "entities"},
  {"href": "/upcoming.html", "icon": "event_upcoming", "label": "Upcoming", "key": "upcoming"},
] + ([{"href": "/value.html", "icon": "payments", "label": value_label, "key": "value"}] if has_value else [])
  + ([{"href": "/queue.html", "icon": "inbox", "label": "Queue", "key": "queue"}] if has_scout_agent else []) %}
{% if item.key == active %}
<a class="flex flex-col items-center p-2 text-primary" href="{{ item.href }}">
<div class="bg-secondary-container text-on-secondary-container px-4 py-1 rounded-full mb-1">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">{{ item.icon }}</span>
</div>
<span class="font-label-caps text-[10px] font-bold">{{ item.label }}</span>
</a>
{% else %}
<a class="flex flex-col items-center p-2 text-on-surface-variant" href="{{ item.href }}">
<span class="material-symbols-outlined mb-1">{{ item.icon }}</span><span class="font-label-caps text-[10px]">{{ item.label }}</span>
</a>
{% endif %}
{% endfor %}
</nav>
{%- endmacro %}

{% macro mobile_brand() -%}
<div class="md:hidden flex items-center gap-2">
<img src="logo.svg" alt="" class="w-8 h-8"/>
<span class="font-headline-md text-headline-md font-extrabold text-primary">{{ app_display_name }}</span>
</div>
{%- endmacro %}

{% macro avatar_badge() -%}
<div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold border-2 border-surface-container-highest">{{ user_initial }}</div>
{%- endmacro %}
