{# Shared macros for every dashboard page. Not rendered as a standalone file
   -- generate_project.py never emits this one directly, only files that
   {% import %} it. Keeps the 5 pages visually and structurally consistent
   without hand-copying the Tailwind theme/nav into each one. #}

{% macro theme_head(page_title) -%}
<title>{{ app_display_name }} - {{ page_title }}</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Quicksand:wght@500;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script id="tailwind-config">
  tailwind.config = {
    darkMode: "class",
    theme: { extend: {
      "colors": {
        "surface-container": "#f9ecde", "on-tertiary-fixed": "#002204", "error-container": "#ffdad6",
        "surface-dim": "#e5d8ca", "background": "#fff8f3", "primary": "#b71422", "on-error": "#ffffff",
        "on-background": "#211b12", "secondary-fixed": "#ffe16d", "on-surface": "#211b12", "on-primary": "#ffffff",
        "surface-container-highest": "#eee0d2", "outline-variant": "#e4beba", "on-primary-fixed": "#410004",
        "on-secondary-fixed": "#221b00", "surface": "#fff8f3", "on-surface-variant": "#5b403e",
        "tertiary-fixed-dim": "#78dc77", "on-primary-container": "#fffbff", "inverse-primary": "#ffb3ae",
        "surface-container-lowest": "#ffffff", "on-secondary-fixed-variant": "#544600", "surface-tint": "#ba1724",
        "surface-container-low": "#fff1e3", "on-primary-fixed-variant": "#930014", "error": "#ba1a1a",
        "primary-container": "#db3237", "outline": "#8f6f6d", "inverse-on-surface": "#fcefe0",
        "inverse-surface": "#362f26", "surface-variant": "#eee0d2", "secondary-container": "#fcd400",
        "surface-bright": "#fff8f3", "tertiary-container": "#1e862d", "on-secondary-container": "#6e5c00",
        "on-error-container": "#93000a", "primary-fixed-dim": "#ffb3ae", "tertiary-fixed": "#94f990",
        "primary-fixed": "#ffdad7", "tertiary": "#006b1b", "on-tertiary-fixed-variant": "#005313",
        "on-secondary": "#ffffff", "on-tertiary": "#ffffff", "on-tertiary-container": "#f7fff1",
        "secondary-fixed-dim": "#e9c400", "surface-container-high": "#f3e6d8", "secondary": "#705d00"
      },
      "borderRadius": { "DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px" },
      "spacing": { "section-margin": "48px", "stack-gap": "12px", "gutter": "16px", "unit": "8px", "container-padding": "24px" },
      "fontFamily": {
        "headline-lg-mobile": ["Plus Jakarta Sans"], "label-caps": ["Quicksand"], "body-lg": ["Quicksand"],
        "body-md": ["Quicksand"], "headline-md": ["Plus Jakarta Sans"], "headline-lg": ["Plus Jakarta Sans"]
      },
      "fontSize": {
        "headline-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "800" }],
        "label-caps": ["14px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "700" }],
        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "500" }],
        "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "500" }],
        "headline-md": ["28px", { "lineHeight": "1.3", "fontWeight": "700" }],
        "headline-lg": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "800" }]
      }
    } }
  }
</script>
<style>
  body { background-color: theme('colors.background'); color: theme('colors.on-background'); }
  .soft-shadow { box-shadow: 0 10px 30px rgba(74, 66, 56, 0.08); }
  .squishy-btn:active { transform: translateY(2px); box-shadow: 0 4px 10px rgba(74, 66, 56, 0.05); }
</style>
{%- endmacro %}

{% macro sidebar_nav(active) -%}
<nav class="hidden md:flex bg-surface-container-low h-screen w-64 rounded-r-lg shadow-sm flex-col py-8 px-4 border-r border-outline-variant/20 z-50 flex-shrink-0">
<div class="mb-10 px-4 flex items-center gap-3">
<div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-on-primary">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">{{ icon }}</span>
</div>
<div>
<h1 class="font-headline-md text-headline-md font-extrabold text-primary">{{ app_display_name }}</h1>
<p class="font-body-md text-body-md text-on-surface-variant text-sm">{{ tagline }}</p>
</div>
</div>
<div class="flex-1 flex flex-col gap-2">
{% for item in [
  {"href": "/", "icon": "dashboard", "label": "Overview", "key": "overview"},
  {"href": "/" ~ entity_plural ~ ".html", "icon": "work", "label": entity_plural_label, "key": "entities"},
  {"href": "/upcoming.html", "icon": "event_upcoming", "label": "Upcoming", "key": "upcoming"},
] + ([{"href": "/value.html", "icon": "payments", "label": value_label, "key": "value"}] if has_value else [])
  + ([{"href": "/queue.html", "icon": "inbox", "label": "Queue", "key": "queue", "badge": true}] if has_scout_agent else []) %}
{% if item.key == active %}
<a class="flex items-center gap-3 bg-secondary-container text-on-secondary-container font-bold rounded-full px-4 py-3" href="{{ item.href }}">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">{{ item.icon }}</span><span class="font-label-caps text-label-caps">{{ item.label }}</span>
{% if item.badge %}<span id="navQueueCount" class="ml-auto bg-primary text-on-primary text-[11px] font-bold rounded-full w-5 h-5 flex items-center justify-center"></span>{% endif %}
</a>
{% else %}
<a class="flex items-center gap-3 text-on-surface-variant px-4 py-3 hover:bg-surface-container-high transition-colors duration-200 rounded-full" href="{{ item.href }}">
<span class="material-symbols-outlined">{{ item.icon }}</span><span class="font-label-caps text-label-caps">{{ item.label }}</span>
{% if item.badge %}<span id="navQueueCount" class="ml-auto bg-primary text-on-primary text-[11px] font-bold rounded-full w-5 h-5 flex items-center justify-center"></span>{% endif %}
</a>
{% endif %}
{% endfor %}
</div>
</nav>
{%- endmacro %}

{% macro mobile_nav(active) -%}
<nav class="md:hidden fixed bottom-0 w-full bg-surface-container-low shadow-[0_-4px_20px_rgba(0,0,0,0.05)] z-50 px-4 py-2 flex justify-between items-center">
{% for item in [
  {"href": "/", "icon": "dashboard", "label": "Overview", "key": "overview"},
  {"href": "/" ~ entity_plural ~ ".html", "icon": "work", "label": "Items", "key": "entities"},
  {"href": "/upcoming.html", "icon": "event_upcoming", "label": "Upcoming", "key": "upcoming"},
] + ([{"href": "/value.html", "icon": "payments", "label": value_label, "key": "value"}] if has_value else [])
  + ([{"href": "/queue.html", "icon": "inbox", "label": "Queue", "key": "queue"}] if has_scout_agent else []) %}
{% if item.key == active %}
<a class="flex flex-col items-center p-2 text-primary" href="{{ item.href }}">
<div class="bg-secondary-container text-on-secondary-container px-4 py-1 rounded-full mb-1">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">{{ item.icon }}</span>
</div>
<span class="font-label-caps text-[10px] font-bold">{{ item.label }}</span>
</a>
{% else %}
<a class="flex flex-col items-center p-2 text-on-surface-variant" href="{{ item.href }}">
<span class="material-symbols-outlined mb-1">{{ item.icon }}</span><span class="font-label-caps text-[10px]">{{ item.label }}</span>
</a>
{% endif %}
{% endfor %}
</nav>
{%- endmacro %}

{% macro mobile_brand() -%}
<div class="md:hidden flex items-center gap-2">
<div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-on-primary">
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">{{ icon }}</span>
</div>
<span class="font-headline-md text-headline-md font-extrabold text-primary">{{ app_display_name }}</span>
</div>
{%- endmacro %}

{% macro avatar_badge() -%}
<div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold border-2 border-surface-container-highest">{{ user_initial }}</div>
{%- endmacro %}
